    <property name="styleSheet">
     <string notr="true">/* 设置滑动条的凹槽（背景长条） */
QSlider::groove:horizontal {
    height: 8px; /* 凹槽的高度 */
    background: rgb(255, 255, 255);
    border-radius: 4px;
}

/* 设置滑钮（中间那个圆块）的大小 */
QSlider::handle:horizontal {
    background: rgb(187, 212, 239); /* 滑钮颜色 */
    width: 20px;         /* 关键属性：调节宽度 */
    height: 20px;        /* 关键属性：调节高度 */
    margin: -7px 0;      /* 关键技巧：负边距让滑钮垂直居中并突出凹槽 */
    border-radius: 10px; /* 圆角：设为宽高的一半即为圆形 */
    border: 1px solid rgb(187, 212, 239);
}</string>
    </property>
    <property name="orientation">
     <enum>Qt::Horizontal</enum>
    </property>
   </widget>
