    <property name="styleSheet">
     <string notr="true">/* 美化表头：实现加粗及中英文字体兼容 */
QHeaderView::section {
    background-color: #f0f0f0;
    padding: 2px;
    border: 1px solid #dcdcdc;
    /* 使用复合简写属性：粗细 字符大小 字体家族 */
    font: bold 12pt &quot;Times New Roman&quot;, &quot;宋体&quot;;
    color: #333333;
}

/* 统一表格内容风格 */
QTableWidget {
    background-color: #ffffff;
    gridline-color: #dcdcdc;
    border: 1px solid #bcbcbc;
    selection-background-color: #0078d7;
    /* 内容部分建议不加粗，以区分表头 */
    font: 12pt &quot;Times New Roman&quot;, &quot;宋体&quot;;
}</string>
